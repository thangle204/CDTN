MONGO_URI=mongodb://127.0.0.1:27017/shoe_store
# Optional: up to 3 comma-separated DNS server IPs for this Node process's
# resolve* lookups, including MongoDB SRV/TXT. Empty preserves current defaults.
# Does not change Windows/system DNS. Example: 1.1.1.1,8.8.8.8
MONGO_DNS_SERVERS=
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
FRONTEND_URL=http://localhost:5173

# VNPAY Sandbox only. Register your own merchant; do not use a real payment key.
# IPN must be a public HTTPS URL registered with VNPAY; localhost cannot receive it.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_IPN_URL=
# Empty: choose a supported method at VNPAY (e.g. NCB Sandbox test card).
# VNPAYQR: show QR directly only when the Sandbox merchant supports it.
VNPAY_BANK_CODE=
VNPAY_TIMEOUT_MINUTES=15
# Local IPN-only relay. Forward the public tunnel to this port, not the full API.
VNPAY_IPN_PORT=5010

# Optional: MongoDB credentials/cluster for isolated integration tests.
# The runner always selects a new owned shoe_store_it_* database, never resets the URI database.
MONGO_TEST_URI=

# Optional: required for password recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: used only by npm run seed -- --reset.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
