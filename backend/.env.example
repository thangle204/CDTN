MONGO_URI=mongodb://127.0.0.1:27017/shoe_store
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional: MongoDB credentials/cluster for isolated integration tests.
# The runner always selects a new owned shoe_store_it_* database, never resets the URI database.
MONGO_TEST_URI=

# Optional: required for password recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: used only by npm run seed -- --reset.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
