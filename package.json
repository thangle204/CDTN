{
  "name": "shoe-store",
  "version": "1.0.0",
  "description": "SHOE STORE - Vietnamese shoe store API and frontend",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon --exitcrash backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "node scripts/dev.js",
    "dev:vnpay": "node scripts/dev.js --vnpay",
    "vnpay:ipn": "node backend/vnpayIpnRelay.js",
    "build": "npm run build --prefix frontend",
    "test": "node --test backend/tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 backend/integration/*.integration.test.js",
    "check:db": "node backend/checkDb.js",
    "check:vnpay": "node backend/checkVnpay.js",
    "seed": "node backend/createData.js",
    "test:frontend": "npm run test --prefix frontend"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "nodemailer": "^7.0.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
